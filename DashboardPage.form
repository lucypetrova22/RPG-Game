<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="DashboardPage">
  <grid id="27dc6" layout-manager="BorderLayout" row-count="1" column-count="1">
    <constraints/>
    <children>
      <component id="headerPanel" class="javax.swing.JPanel" binding="headerPanel">
        <constraints>
          <border-constraints value="North"/>
        </constraints>
        <properties>
          <background color="0x2196F3"/>
          <preferredSize width="800" height="60"/>
        </properties>
        <layout manager="BorderLayout"/>
        <children>
          <component id="titleLabel" class="javax.swing.JLabel" binding="titleLabel">
            <constraints>
              <border-constraints value="West"/>
            </constraints>
            <properties>
              <text value="Construction Dashboard"/>
              <foreground color="0xFFFFFF"/>
              <font name="SansSerif" size="22" style="1"/>
            </properties>
          </component>
        </children>
      </component>

      <component id="buttonPanel" class="javax.swing.JPanel" binding="buttonPanel">
        <constraints>
          <border-constraints value="Center"/>
        </constraints>
        <properties>
          <background color="0xF5F7FA"/>
          <border type="empty" top="30" left="30" bottom="30" right="30"/>
        </properties>
        <layout manager="GridLayout" hgap="20" vgap="20">
          <property name="rows" value="2"/>
          <property name="columns" value="3"/>
        </layout>
        <children>
          <component id="clientsButton" class="javax.swing.JButton" binding="clientsButton">
            <constraints/>
            <properties>
              <text value="Clients"/>
            </properties>
          </component>
          <component id="subcontractorsButton" class="javax.swing.JButton" binding="subcontractorsButton">
            <constraints/>
            <properties>
              <text value="Subcontractors"/>
            </properties>
          </component>
          <component id="revenueButton" class="javax.swing.JButton" binding="revenueButton">
            <constraints/>
            <properties>
              <text value="Revenue"/>
            </properties>
          </component>
          <component id="salesButton" class="javax.swing.JButton" binding="salesButton">
            <constraints/>
            <properties>
              <text value="Sales"/>
            </properties>
          </component>
          <component id="productsButton" class="javax.swing.JButton" binding="productsButton">
            <constraints/>
            <properties>
              <text value="Products"/>
            </properties>
          </component>
          <component id="discountsButton" class="javax.swing.JButton" binding="discountsButton">
            <constraints/>
            <properties>
              <text value="Discounts"/>
            </properties>
          </component>
        </children>
      </component>
    </children>
  </grid>
</form>
